{
  "routes": [
    {
      "route": "/api/*",
      "rewrite": "https://bagelb0y-c6gfhyfsheebdzdm.canadacentral-01.azurewebsites.net/api/",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/*.{jpg,jpeg,png,gif,webp,svg,ico}",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/*.{css,scss,js,png,gif,ico,jpg,svg}"]
  },
  "mimeTypes": {
    ".json": "application/json"
  },
  "globalHeaders": {
    "Cache-Control": "public, max-age=300"
  },
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/"
    }
  }
}
